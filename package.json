  "repository": {
    "type": "git",
    "url": "git+https://github.com/soaressilves/faillens.git"
  },
  "bugs": {
    "url": "https://github.com/soaressilves/faillens/issues"
  },
  "homepage": "https://github.com/soaressilves/faillens#readme"
}
